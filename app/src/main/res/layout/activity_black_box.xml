<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#090B10" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="18dp" android:paddingEnd="18dp" android:paddingBottom="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/blackBoxBack" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textColor="#E9EDF5" android:textSize="34sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Чёрный ящик" android:textColor="#F2F4F8" android:textSize="18sp" android:textStyle="bold" />
            <View android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Статус" android:textColor="#AAB2C0" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#121721" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/blackBoxStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Неактивен" android:textColor="#73E18A" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/blackBoxRemaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="—" android:textColor="#EEF1F5" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/blackBoxStarted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Начало: —" android:textColor="#929CAA" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Профиль" android:textColor="#AAB2C0" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#121721" android:padding="18dp" android:text="VOICE / TTS diagnostics" android:textColor="#C8A7FF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Длительность" android:textColor="#AAB2C0" android:textSize="13sp" />
        <RadioGroup android:id="@+id/blackBoxDurationGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#121721" android:orientation="vertical" android:padding="12dp">
            <RadioButton android:id="@+id/blackBoxDuration1" android:layout_width="match_parent" android:layout_height="48dp" android:text="1 минута" android:textColor="#EEF1F5" />
            <RadioButton android:id="@+id/blackBoxDuration5" android:layout_width="match_parent" android:layout_height="48dp" android:checked="true" android:text="5 минут" android:textColor="#EEF1F5" />
            <RadioButton android:id="@+id/blackBoxDuration10" android:layout_width="match_parent" android:layout_height="48dp" android:text="10 минут" android:textColor="#EEF1F5" />
            <RadioButton android:id="@+id/blackBoxDuration30" android:layout_width="match_parent" android:layout_height="48dp" android:text="30 минут" android:textColor="#EEF1F5" />
        </RadioGroup>
        <Button android:id="@+id/blackBoxAction" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="24dp" android:background="#252C37" android:text="АКТИВИРОВАТЬ" android:textColor="#F2F4F8" android:textStyle="bold" />
        <TextView android:id="@+id/blackBoxFile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Файл ещё не создан" android:textColor="#929CAA" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
