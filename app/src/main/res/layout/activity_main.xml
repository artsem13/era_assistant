<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- КОСМИЧЕСКИЙ ФОН -->

    <ImageView
        android:id="@+id/eraSpaceBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/moon"
        android:scaleType="centerCrop"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />


    <!-- ОСНОВНОЙ ИНТЕРФЕЙС -->

    <FrameLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp">

        <!-- CONVERSATION LAYER -->

        <ScrollView
            android:id="@+id/chatScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chatMessagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <FrameLayout
                    android:id="@+id/searchStatusCard"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_search_status_card"
                    android:visibility="gone">

                    <com.era.assistant.core.ui.SearchPulseView
                        android:id="@+id/searchStatusAnimation"
                        android:layout_width="60dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="70dp"
                        android:paddingRight="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Ищу в интернете…"
                                android:textColor="#F0F1F3"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Поиск актуальной информации"
                                android:textColor="#969BA5"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/searchStatusCancel"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:minWidth="56dp"
                            android:paddingLeft="8dp"
                            android:paddingRight="4dp"
                            android:text="Отмена"
                            android:textColor="#C9CDD4"
                            android:textSize="13sp" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

        </ScrollView>

        <!-- ВИЗУАЛЬНЫЕ ГРАНИЦЫ CONVERSATION; TOUCH НЕ ПЕРЕХВАТЫВАЮТ -->

        <View
            android:id="@+id/conversationTopFade"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="top"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <View
            android:id="@+id/conversationBottomFade"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <!-- ВЕРХНИЕ CONTROLS OVERLAY -->

        <LinearLayout
            android:id="@+id/topControls"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ГАМБУРГЕР -->

            <Button
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_menu_button"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="☰"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <!-- ЗАМЕТКИ -->

            <ImageButton
                android:id="@+id/noteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_menu_button"
                android:contentDescription="Заметка"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_note_pen"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/blackBoxIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#FF9A9A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- РАЗОВЫЙ STT -->

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_menu_button"
                android:contentDescription="Микрофон"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                android:tint="#FFFFFF" />

            <!-- ГОЛОСОВОЙ РЕЖИМ -->

            <ImageButton
                android:id="@+id/voiceModeButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_menu_button"
                android:contentDescription="Голосовой режим"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_voice_mode"
                android:tint="#FFFFFF" />

            <Button
                android:id="@+id/interruptButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_menu_button"
                android:text="INTERRUPT"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ПОЛЕ ВВОДА OVERLAY -->

        <LinearLayout
            android:id="@+id/inputPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_message_input"
                android:gravity="center_vertical|start"
                android:hint="Спросить Эру..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="52dp"
                android:paddingLeft="18dp"
                android:paddingTop="10dp"
                android:paddingRight="18dp"
                android:paddingBottom="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/sendApiButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginLeft="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Отправить"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/earth_send" />

        </LinearLayout>

    </FrameLayout>


    <!-- ЗАТЕМНЕНИЕ ЗА МЕНЮ -->

    <View
        android:id="@+id/menuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />


    <!-- ВЫЕЗЖАЮЩЕЕ МЕНЮ -->

    <LinearLayout
        android:id="@+id/sideMenu"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_side_menu"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/menuInstructions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="22dp"
            android:paddingRight="18dp"
            android:text="Инструкции"
            android:textColor="#F2F4F8"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:background="#252C37" />

        <TextView
            android:id="@+id/menuModel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="22dp"
            android:paddingRight="18dp"
            android:text="Модель"
            android:textColor="#F2F4F8"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:background="#252C37" />

        <TextView
            android:id="@+id/menuUsage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="22dp"
            android:paddingRight="18dp"
            android:text="Использование"
            android:textColor="#F2F4F8"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:background="#252C37" />

        <TextView
            android:id="@+id/menuBlackBox"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="22dp"
            android:paddingRight="18dp"
            android:text="Чёрный ящик"
            android:textColor="#F2F4F8"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:background="#252C37" />

        <TextView
            android:id="@+id/menuApiKey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="22dp"
            android:paddingRight="18dp"
            android:text="Выбрать API-ключ"
            android:textColor="#F2F4F8"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:background="#252C37" />

        <TextView
            android:id="@+id/menuChatGpt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="22dp"
            android:paddingRight="18dp"
            android:text="Запустить ChatGPT"
            android:textColor="#F2F4F8"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:background="#252C37" />

        <TextView
            android:id="@+id/menuLockTest"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="22dp"
            android:paddingRight="18dp"
            android:text="Тест блокировки — 10 сек"
            android:textColor="#F2F4F8"
            android:textSize="16sp" />

        <View
            android:id="@+id/menuSearchPreviewDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:background="#252C37"
            android:visibility="gone" />

        <TextView
            android:id="@+id/menuSearchPreview"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="22dp"
            android:paddingRight="18dp"
            android:text="Preview: Internet Search"
            android:textColor="#F2F4F8"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>